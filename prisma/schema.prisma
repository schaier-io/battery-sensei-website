// Battery Sensei — contact form persistence.
//
// One table stores every contact-form submission that passes input
// validation. Both the raw (as-received) payload and the cleaned/validated
// fields are persisted, so we can audit exactly what was sent and how it
// was normalised. Rate limiting is a count aggregate over this same table.

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  // Emit `.js` in generated import paths so that after Vite/Vercel
  // transpiles the generated `.ts` files to `.js`, the imports still
  // resolve at runtime. TS resolves `./enums.js` → `./enums.ts` at
  // build time via `moduleResolution: "bundler"`.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SupportRequestStatus {
  pending
  sent
  failed
  rate_limited_email
  rate_limited_ip
  honeypot
}

enum NewsletterSource {
  pricing_free
  thanks_page
  other
}

/// Free-download email capture (homepage Pricing card + future surfaces).
///
/// Every successful signup is upserted here and mirrored to two operational
/// Resend segments within one disclosed Battery Sensei updates scope. The
/// mirror happens server-side in `api/free-signup.ts`; the returned contact id
/// supports retries and unsubscribe handling.
model NewsletterSignup {
  id     String @id @default(cuid())
  email  String @unique
  locale String @default("en")
  source NewsletterSource @default(pricing_free)

  /// Contact id returned by Resend for the "Sensei releases" audience.
  /// Null until the first fan-out succeeds; non-null on retry skips.
  releasesContactId String?
  /// Contact id returned by Resend for the "future app launches" audience.
  launchesContactId String?

  /// Request metadata — same pattern as SupportRequest, used purely for
  /// abuse investigation. Never displayed back to the visitor.
  ipAddress String?
  userAgent String?
  origin    String?

  /// Soft opt-out so we can stop emailing without losing the row (and the
  /// ability to dedupe a future re-signup against the same address).
  unsubscribedAt DateTime?

  /// Set when the double-opt-in confirm link is clicked. Lets the
  /// confirm endpoint be idempotent without round-tripping Resend.
  confirmedAt DateTime?

  /// Monotonic version counter for outstanding signed tokens. Bumped
  /// whenever the subscription state should invalidate prior links
  /// (resubscribe after unsub, manual revocation). Both confirm and
  /// unsubscribe tokens carry the epoch at issue-time; mismatch → token
  /// rejected. Lets unsubscribe URLs live "forever" without becoming a
  /// permanent off-switch leak.
  tokenEpoch Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// IP rate limit lookup: count rows where ipAddress = ? and createdAt > ?.
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
}

model SupportRequest {
  id       String @id @default(cuid())
  // Short shared identifier shown to the visitor and in the inbox.
  ticketId String @unique

  // Raw, unmodified input as received from the client (post JSON.parse).
  // Individual raw fields are kept for quick lookups; rawPayload is the
  // full object for audit completeness.
  rawName    String?
  rawEmail   String?
  rawTopic   String?
  rawSubject String?
  rawMessage String?
  rawPayload Json

  // Cleaned/validated values from the zod schema. These are what gets
  // rendered into the support email (after HTML escaping).
  name    String
  email   String
  topic   String
  subject String
  message String

  // Request metadata for abuse investigation.
  ipAddress String?
  userAgent String?
  origin    String?

  // Resend message ids — useful for tracing delivery failures.
  supportEmailId      String?
  confirmationEmailId String?

  status SupportRequestStatus @default(pending)

  /// Optional operational hold for an active dispute or legal obligation.
  /// The daily retention job skips the row until this UTC timestamp passes.
  retentionHoldUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email rate limit lookup: count rows where email = ? and createdAt > ?.
  @@index([email, createdAt])
  // IP rate limit lookup: count rows where ipAddress = ? and createdAt > ?.
  @@index([ipAddress, createdAt])
  // Operational dashboards: filter by status + recency.
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

/// Lifecycle of a public feature request. `pending` and `rejected` are
/// never exposed publicly; the other four double as roadmap columns.
enum FeatureRequestStatus {
  pending
  open
  planned
  in_progress
  shipped
  rejected
}

enum FeatureRequestSource {
  web
  app
}

/// A feature request on the public board. Same raw+cleaned audit pattern
/// as SupportRequest. Public endpoints only ever render publicTitle/
/// publicBody (falling back to the cleaned title/body) — never raw*,
/// email, or name.
model FeatureRequest {
  id       String @id @default(cuid())
  // Short shared identifier shown to the submitter and in the inbox.
  ticketId String @unique

  // Raw, unmodified input as received from the client (post JSON.parse).
  rawTitle   String?
  rawBody    String?
  rawEmail   String?
  rawName    String?
  rawPayload Json

  // Cleaned/validated values from the zod schema.
  title  String
  body   String
  email  String
  name   String @default("")
  locale String @default("en")

  // Admin-editable copy shown on the public board. Null falls back to
  // the cleaned title/body.
  publicTitle String?
  publicBody  String?

  status FeatureRequestStatus @default(pending)
  source FeatureRequestSource @default(web)

  // Set on reject; emailed to the submitter verbatim (escaped).
  rejectionReason String?
  // Internal-only annotations: honeypot / rate_limited_* / email_failed
  // quarantine markers plus free-form admin notes.
  adminNote String?
  moderatedAt DateTime?

  /// Denormalized vote counter, maintained in the same transaction as
  /// FeatureVote writes so the public list sort is one indexed query.
  votesCount Int @default(0)

  // Request metadata for abuse investigation.
  ipAddress String?
  userAgent String?
  origin    String?

  // Resend message ids — useful for tracing delivery failures.
  adminNotifyEmailId  String?
  confirmationEmailId String?
  decisionEmailId     String?

  /// Set after the daily retention job removes submitter/raw/request data
  /// from an approved public entry while preserving its public copy/count.
  privateDataPurgedAt DateTime?
  /// Optional operational hold for an active dispute or legal obligation.
  retentionHoldUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes FeatureVote[]

  // Public list: visible statuses sorted by votes.
  @@index([status, votesCount])
  // Admin dashboard filters.
  @@index([status, createdAt])
  // Email rate limit lookup.
  @@index([email, createdAt])
  // IP rate limit lookup.
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([privateDataPurgedAt, moderatedAt])
}

/// One vote per license per request. voterHash is
/// HMAC-SHA256(licenseKey, FEATURE_VOTE_HASH_SECRET) hex — the raw key
/// is never stored or logged.
model FeatureVote {
  id        String         @id @default(cuid())
  requestId String
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voterHash String
  ipAddress String?
  createdAt DateTime @default(now())

  @@unique([requestId, voterHash])
  // "Which requests did this key vote for" lookup.
  @@index([voterHash])
  // Vote-mutation rate limit lookup.
  @@index([ipAddress, createdAt])
  // Daily privacy retention pass: clear vote IP after 30 days.
  @@index([createdAt])
}

/// Cache of successful Polar license validations keyed by voterHash, so
/// vote/check calls within 24h skip the Polar round-trip.
model LicenseVoter {
  voterHash       String   @id
  lastValidatedAt DateTime
  createdAt       DateTime @default(now())
}

/// Durable rate limiting for /api/admin/session login attempts.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String?
  success   Boolean
  /// Optional security-incident/legal hold; daily cleanup skips until expiry.
  retentionHoldUntil DateTime?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([createdAt])
}
