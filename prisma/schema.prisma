// Battery Sensei — contact form persistence.
//
// One table stores every contact-form submission that passes input
// validation. Both the raw (as-received) payload and the cleaned/validated
// fields are persisted, so we can audit exactly what was sent and how it
// was normalised. Rate limiting is a count aggregate over this same table.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SupportRequestStatus {
  pending
  sent
  failed
  rate_limited_email
  rate_limited_ip
  honeypot
}

enum NewsletterSource {
  pricing_free
  thanks_page
  other
}

/// Free-download email capture (homepage Pricing card + future surfaces).
///
/// Every successful signup is upserted here AND mirrored to two Resend
/// Audiences:
///   - releases: per-app build alerts ("new Sensei version is out")
///   - launches: cross-app announcements ("new app from the same maker")
/// The mirror happens server-side in `api/free-signup.ts`. We store the
/// returned Resend contact ids so retries / unsubscribes can target the
/// right rows.
model NewsletterSignup {
  id     String @id @default(cuid())
  email  String @unique
  locale String @default("en")
  source NewsletterSource @default(pricing_free)

  /// Contact id returned by Resend for the "Sensei releases" audience.
  /// Null until the first fan-out succeeds; non-null on retry skips.
  releasesContactId String?
  /// Contact id returned by Resend for the "future app launches" audience.
  launchesContactId String?

  /// Request metadata — same pattern as SupportRequest, used purely for
  /// abuse investigation. Never displayed back to the visitor.
  ipAddress String?
  userAgent String?
  origin    String?

  /// Soft opt-out so we can stop emailing without losing the row (and the
  /// ability to dedupe a future re-signup against the same address).
  unsubscribedAt DateTime?

  /// Set when the double-opt-in confirm link is clicked. Lets the
  /// confirm endpoint be idempotent without round-tripping Resend.
  confirmedAt DateTime?

  /// Monotonic version counter for outstanding signed tokens. Bumped
  /// whenever the subscription state should invalidate prior links
  /// (resubscribe after unsub, manual revocation). Both confirm and
  /// unsubscribe tokens carry the epoch at issue-time; mismatch → token
  /// rejected. Lets unsubscribe URLs live "forever" without becoming a
  /// permanent off-switch leak.
  tokenEpoch Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// IP rate limit lookup: count rows where ipAddress = ? and createdAt > ?.
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
}

model SupportRequest {
  id       String @id @default(cuid())
  // Short shared identifier shown to the visitor and in the inbox.
  ticketId String @unique

  // Raw, unmodified input as received from the client (post JSON.parse).
  // Individual raw fields are kept for quick lookups; rawPayload is the
  // full object for audit completeness.
  rawName    String?
  rawEmail   String?
  rawTopic   String?
  rawSubject String?
  rawMessage String?
  rawPayload Json

  // Cleaned/validated values from the zod schema. These are what gets
  // rendered into the support email (after HTML escaping).
  name    String
  email   String
  topic   String
  subject String
  message String

  // Request metadata for abuse investigation.
  ipAddress String?
  userAgent String?
  origin    String?

  // Resend message ids — useful for tracing delivery failures.
  supportEmailId      String?
  confirmationEmailId String?

  status SupportRequestStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email rate limit lookup: count rows where email = ? and createdAt > ?.
  @@index([email, createdAt])
  // IP rate limit lookup: count rows where ipAddress = ? and createdAt > ?.
  @@index([ipAddress, createdAt])
  // Operational dashboards: filter by status + recency.
  @@index([status, createdAt])
  @@index([createdAt])
}
