# Battery Sensei — example environment file.
#
# Copy this to `.env.local` (gitignored) for local dev, or set the same keys
# in Vercel → Project Settings → Environment Variables for deploys.
#
# Two categories:
#   - VITE_*   bundled into the client. Public — never put a secret here.
#   - others   server-only (api/*.ts on Vercel Functions). Never bundled.
#
# Everything below is REQUIRED for the listed feature to work. Missing keys
# don't crash the build — the affected endpoint just returns an error or
# falls back to a canonical default (e.g. /api/price returns the locale
# price table when Polar keys are missing).

# ────────────────────────────────────────────────────────────────────
# Polar.sh — checkout  (client)
# ────────────────────────────────────────────────────────────────────
# The pricing CTAs open an EMBEDDED checkout (a modal iframe served by
# Polar) so the visitor stays on our domain. The Polar URLs below are
# the iframe `src` — the embed library can't fabricate them, so for
# production you still create the two products in Polar and paste
# their Checkout Link URLs here.
#
# Two products in Polar dashboard:
#   1. Lifetime  — one-time, base price $9.99. Create a discount code
#      "ZENMODE" with the configured max redemptions giving $3 off (→ $6.99).
#      Lifetime checkouts auto-apply ZENMODE via ?discount_code=ZENMODE.
#   2. Yearly Patron — recurring yearly, $2.99/year.
#
# For each product's Checkout Link in Polar, set the Success URL to:
#   https://battery-sensei.app/thanks/lifetime?checkout_id={CHECKOUT_ID}
#   https://battery-sensei.app/thanks/support?checkout_id={CHECKOUT_ID}
# and enable success redirect so the embed navigates the parent window
# to our thank-you page after purchase.

# Local dev / preview: skip Polar entirely. Buy buttons open a small
# in-page "Pretend payment" overlay that always succeeds, then jumps
# to /thanks/<tier>. Lets you wire the thank-you flow without a real
# Polar account or card. Leave this set in `.env.local`; never set
# it on the production environment.
VITE_POLAR_FAKE_CHECKOUT=true

# Full Checkout Link URL for the Lifetime product. Required when
# VITE_POLAR_FAKE_CHECKOUT is unset/false. Example:
#   https://buy.polar.sh/polar_cl_xxxxxxxxxxxxxxxx
VITE_POLAR_CHECKOUT_URL_LIFETIME=https://buy.polar.sh/your-legacy-lifetime-checkout-link

# Full Checkout Link URL for the yearly Ongoing Developer Support
# product. Required when VITE_POLAR_FAKE_CHECKOUT is unset/false.
VITE_POLAR_CHECKOUT_URL_SUPPORT=https://buy.polar.sh/your-legacy-support-checkout-link

# New 41BIT organization checkout links. When set, these override the
# legacy links above for every new purchase.
VITE_POLAR_CHECKOUT_URL_LIFETIME_NEW=
VITE_POLAR_CHECKOUT_URL_SUPPORT_NEW=

# Organization-specific customer portals. The default link uses `_NEW`;
# Legacy portal configuration is retained server-side for lookup responses to
# historical purchase records; it is not linked in the public website.
VITE_POLAR_CUSTOMER_PORTAL_URL=
VITE_POLAR_CUSTOMER_PORTAL_URL_NEW=https://polar.sh/41bit-llc/portal

# ────────────────────────────────────────────────────────────────────
# Polar.sh — live price preview  (server only, api/price.ts)
# ────────────────────────────────────────────────────────────────────
# Used to show the visitor's local currency + VAT on the homepage and
# checkout page. If any of these is missing the client gracefully falls
# back to the canonical locale price table — the site still works.
#
# Support and Lifetime products are queried live when both ids are configured.
# If the Lifetime id is absent, the client can still use its locale fallback.

# Existing organization token. Keep it so old checkout result pages can still
# retrieve their license during the 15-minute delivery window.
POLAR_ACCESS_TOKEN=

# New 41BIT organization token. New checkouts, prices, and discounts prefer it.
POLAR_ACCESS_TOKEN_NEW=

# Existing and new organization UUIDs. Voting validates against new first,
# then legacy only after a definitive 403/404 wrong-organization response.
POLAR_ORGANIZATION_ID=19c1e866-7c79-4c07-b7bf-f91f09e08d92
POLAR_ORGANIZATION_ID_NEW=7663fdb9-28b9-4ade-ad3b-e2a6e072d5f7
POLAR_ORGANIZATION_SLUG_NEW=41bit-llc

# Server-side portal fallbacks used by checkout license delivery.
POLAR_CUSTOMER_PORTAL_URL=
POLAR_CUSTOMER_PORTAL_URL_NEW=https://polar.sh/41bit-llc/portal

# Deprecated legacy alias. Leave empty once POLAR_PRODUCT_ID_SUPPORT is set.
POLAR_PRODUCT_ID=

# UUIDs of the Lifetime + Support products. Required by /api/checkout-
# session so we can create Checkout SESSIONS (not just Links) with the
# `embed_origin` parameter — without an embed-origin session, Polar's
# iframe response sets `frame-ancestors: 'none'` and the browser blocks
# the embed with "polar.sh will not allow this page to be displayed".
# If the matching token/product pair is incomplete, checkout fails closed with
# an inline support message; it never mixes products between organizations.
POLAR_PRODUCT_ID_LIFETIME=
POLAR_PRODUCT_ID_SUPPORT=

# New 41BIT organization products. These are required for every new checkout
# and live-price preview. Legacy ids above remain only for existing customers.
POLAR_PRODUCT_ID_LIFETIME_NEW=
POLAR_PRODUCT_ID_SUPPORT_NEW=

# Lifetime launch discount. New sales, price previews, and redemption counts
# read only the `_NEW` values. Polar's live response supplies actual used/max
# counts; scarcity UI stays hidden if that lookup is unavailable.
POLAR_DISCOUNT_CODE=ZENMODE
POLAR_DISCOUNT_CODE_NEW=ZENMODE
POLAR_DISCOUNT_MAX_REDEMPTIONS=500
POLAR_DISCOUNT_MAX_REDEMPTIONS_NEW=500
VITE_POLAR_DISCOUNT_CODE=ZENMODE
VITE_POLAR_DISCOUNT_CODE_NEW=ZENMODE
VITE_POLAR_DISCOUNT_MAX_REDEMPTIONS=500
VITE_POLAR_DISCOUNT_MAX_REDEMPTIONS_NEW=500

# Public origin where the embedded checkout runs. Must EXACTLY match the
# scheme + host (no path, no trailing slash) the visitor's browser will
# send. Used as `embed_origin` on every Checkout Session create call.
# Defaults to https://battery-sensei.app if unset.
POLAR_EMBED_ORIGIN=https://battery-sensei.app

# ────────────────────────────────────────────────────────────────────
# Resend — contact form  (server only, api/contact.ts)
# ────────────────────────────────────────────────────────────────────
# Required to receive contact form submissions and send the confirmation
# email back to the visitor. Missing keys → /api/contact returns 503 and
# the form shows "Please email us directly".

# API key from resend.com → API Keys. Server-only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal inbox that receives the visitor's message.
CONTACT_INBOX_TO=hello@your-domain.example

# Verified sender on Resend, in "Display Name <address>" format. The visitor
# also sees this as the From: on the confirmation mail.
CONTACT_INBOX_FROM=Battery Sensei <contact@your-domain.example>

# Resend Segments — newsletter fan-out (server only, api/free-signup.ts)
# Resend replaced Audiences with Segments. Create two operational segments in
# resend.com → Segments and paste their ids (UUIDs) below. Both remain inside
# the Battery Sensei release, walkthrough, and product-update scope disclosed
# by every public signup form:
#   1. RESEND_SEGMENT_RELEASES  — release alerts.
#   2. RESEND_SEGMENT_UI_NOTIFY — walkthrough and product updates.
# Every signup is created once as an account-level contact and attached to
# both segments via contacts.create({ segments }).
#
# At least one MUST be set or /api/free-signup returns `misconfigured`.
# Do NOT reuse the legacy "General" audience id here — a segment id
# created in the new Segments UI has no legacy audience record, so the old
# audienceId create path 404s for it.
RESEND_SEGMENT_RELEASES=
RESEND_SEGMENT_UI_NOTIFY=

# ────────────────────────────────────────────────────────────────────
# Newsletter — double opt-in  (server only)
#   api/free-signup.ts            POST  — create pending contact + confirm mail
#   api/newsletter.confirm.ts     GET   — flip to subscribed + welcome mail
#   api/newsletter.unsubscribe.ts GET/POST — RFC 8058 one-click off
# ────────────────────────────────────────────────────────────────────
# Flow:
#   1. Visitor submits the signup form. One account-level Resend contact
#      is created with unsubscribed=true (pending) and attached to BOTH
#      segments. A signed confirm link is emailed.
#   2. Click → confirm endpoint flips the contact to subscribed
#      (unsubscribed=false), which opts it in across both segments at
#      once, and sends the welcome mail with the download link.
#   3. Every email carries RFC 8058 List-Unsubscribe headers pointing
#      at the unsubscribe endpoint, which sets the contact's
#      unsubscribed=true (account-level, applies to every segment).
#
# Templates are server-rendered with React (renderToStaticMarkup). No
# user input is embedded in the HTML — only the HMAC-signed token URL
# and the allowlisted locale. Every signup body is strict-parsed with
# zod (unknown keys rejected, source restricted to [A-Za-z0-9_-]).

# Verified sender used for newsletter emails. Format: "Name <addr>".
# Falls back to RESEND_FROM, then a hardcoded default if unset.
NEWSLETTER_FROM=Battery Sensei <hello@your-domain.example>

# Optional. Where replies route. If unset, replies go to NEWSLETTER_FROM.
NEWSLETTER_REPLY_TO=

# HMAC key signing the confirm + unsubscribe tokens. MUST be >= 32 chars
# and kept secret. Rotating it invalidates all outstanding links.
# Generate with: openssl rand -hex 32
NEWSLETTER_TOKEN_SECRET=

# Public origin used to build absolute URLs in the email body (logo,
# confirm link, unsubscribe link). No trailing slash. Defaults to
# https://battery-sensei.app if unset.
PUBLIC_SITE_URL=https://battery-sensei.app

# ────────────────────────────────────────────────────────────────────
# Daily retention enforcement (server only, api/cron/retention.ts)
# ────────────────────────────────────────────────────────────────────
# Vercel sends this value as `Authorization: Bearer <CRON_SECRET>` when
# invoking the daily retention job. Use a random value of at least 16 chars.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Feature board (roadmap + voting + admin moderation)

# Login key for the /admin moderation dashboard. Long random string
# (>= 32 chars recommended, 16 minimum enforced). Generate with:
# openssl rand -hex 32
ADMIN_DASHBOARD_KEY=

# HMAC key signing the admin session cookie (bs_admin). MUST be >= 32
# chars, distinct from every other secret. Rotating it logs the admin
# out everywhere. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# HMAC key deriving anonymous voter identities from license keys.
# MUST be >= 32 chars. CAUTION: rotating it orphans all existing vote
# identities — votes stay counted, but "already voted" state is lost
# and everyone can vote once more. Generate with: openssl rand -hex 32
FEATURE_VOTE_HASH_SECRET=
