# Battery Sensei — example environment file.
#
# Copy this to `.env.local` (gitignored) for local dev, or set the same keys
# in Vercel → Project Settings → Environment Variables for deploys.
#
# Two categories:
#   - VITE_*   bundled into the client. Public — never put a secret here.
#   - others   server-only (api/*.ts on Vercel Functions). Never bundled.
#
# Everything below is REQUIRED for the listed feature to work. Missing keys
# don't crash the build — the affected endpoint just returns an error or
# falls back to a canonical default (e.g. /api/price returns the locale
# price table when Polar keys are missing).

# ────────────────────────────────────────────────────────────────────
# Polar.sh — checkout  (client)
# ────────────────────────────────────────────────────────────────────
# The pricing CTAs open an EMBEDDED checkout (a modal iframe served by
# Polar) so the visitor stays on our domain. The Polar URLs below are
# the iframe `src` — the embed library can't fabricate them, so for
# production you still create the two products in Polar and paste
# their Checkout Link URLs here.
#
# Two products in Polar dashboard:
#   1. Lifetime  — one-time, base price $11.97. Create a discount code
#      "ZENMODE" with 500 max redemptions giving $7.00 off (→ $4.99).
#      Lifetime checkouts auto-apply ZENMODE via ?discount_code=ZENMODE.
#   2. Ongoing Developer Support — recurring yearly, $3.99/year.
#
# For each product's Checkout Link in Polar, set the Success URL to:
#   https://battery-sensei.app/thanks/lifetime?checkout_id={CHECKOUT_ID}
#   https://battery-sensei.app/thanks/support?checkout_id={CHECKOUT_ID}
# and enable success redirect so the embed navigates the parent window
# to our thank-you page after purchase.

# Local dev / preview: skip Polar entirely. Buy buttons open a small
# in-page "Pretend payment" overlay that always succeeds, then jumps
# to /thanks/<tier>. Lets you wire the thank-you flow without a real
# Polar account or card. Leave this set in `.env.local`; never set
# it on the production environment.
VITE_POLAR_FAKE_CHECKOUT=true

# Full Checkout Link URL for the Lifetime product. Required when
# VITE_POLAR_FAKE_CHECKOUT is unset/false. Example:
#   https://buy.polar.sh/polar_cl_xxxxxxxxxxxxxxxx
VITE_POLAR_CHECKOUT_URL_LIFETIME=https://buy.polar.sh/your-lifetime-checkout-link

# Full Checkout Link URL for the yearly Ongoing Developer Support
# product. Required when VITE_POLAR_FAKE_CHECKOUT is unset/false.
VITE_POLAR_CHECKOUT_URL_SUPPORT=https://buy.polar.sh/your-support-checkout-link

# ────────────────────────────────────────────────────────────────────
# Polar.sh — live price preview  (server only, api/price.ts)
# ────────────────────────────────────────────────────────────────────
# Used to show the visitor's local currency + VAT on the homepage and
# checkout page. If any of these is missing the client gracefully falls
# back to the canonical locale price table — the site still works.
#
# Only the Support (yearly) product is queried live; the Lifetime price
# is derived client-side as `yearly + 1 unit` (full = yearly × 3), so a
# single Polar call covers both tiers in any currency.

# Organization Access Token from Polar dashboard → Settings → Developers.
# Server-only; never expose.
POLAR_ACCESS_TOKEN=

# UUID of the $3.99/yr Ongoing Developer Support product. Dashboard →
# Products → your product → copy ID from the URL or the API panel.
# This same id is the live FX/VAT reference for /api/price.
POLAR_PRODUCT_ID=

# UUIDs of the Lifetime + Support products. Required by /api/checkout-
# session so we can create Checkout SESSIONS (not just Links) with the
# `embed_origin` parameter — without an embed-origin session, Polar's
# iframe response sets `frame-ancestors: 'none'` and the browser blocks
# the embed with "polar.sh will not allow this page to be displayed".
# If either is empty, the matching tier silently falls back to the
# pre-created Checkout Link (full-page redirect, no iframe).
POLAR_PRODUCT_ID_LIFETIME=
POLAR_PRODUCT_ID_SUPPORT=

# Public origin where the embedded checkout runs. Must EXACTLY match the
# scheme + host (no path, no trailing slash) the visitor's browser will
# send. Used as `embed_origin` on every Checkout Session create call.
# Defaults to https://battery-sensei.app if unset.
POLAR_EMBED_ORIGIN=https://battery-sensei.app

# ────────────────────────────────────────────────────────────────────
# Resend — contact form  (server only, api/contact.ts)
# ────────────────────────────────────────────────────────────────────
# Required to receive contact form submissions and send the confirmation
# email back to the visitor. Missing keys → /api/contact returns 503 and
# the form shows "Please email us directly".

# API key from resend.com → API Keys. Server-only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal inbox that receives the visitor's message.
CONTACT_INBOX_TO=hello@your-domain.example

# Verified sender on Resend, in "Display Name <address>" format. The visitor
# also sees this as the From: on the confirmation mail.
CONTACT_INBOX_FROM=Battery Sensei <contact@your-domain.example>

# Resend Audiences — newsletter fan-out (server only, api/free-signup.ts)
# Create two audiences in resend.com → Audiences:
#   1. "Sensei releases" — per-app build alerts shipped from the dashboard.
#   2. "Future app launches" — cross-app announcements ("new app from the
#      same maker"); every Sensei signup also lands here so we don't have
#      to rebuild a list for the next app.
# Paste each audience id (UUID) below. If either is empty, fan-out for
# that audience silently skips (the visitor still gets the download).
#
# RELEASES is REQUIRED for /api/free-signup to work (the pending
# double-opt-in contact is created there). LAUNCHES is optional — if
# unset, the cross-app fan-out is skipped on confirmation.
RESEND_AUDIENCE_RELEASES=
RESEND_AUDIENCE_LAUNCHES=

# ────────────────────────────────────────────────────────────────────
# Newsletter — double opt-in  (server only)
#   api/free-signup.ts            POST  — create pending contact + confirm mail
#   api/newsletter.confirm.ts     GET   — flip to subscribed + welcome mail
#   api/newsletter.unsubscribe.ts GET/POST — RFC 8058 one-click off
# ────────────────────────────────────────────────────────────────────
# Flow:
#   1. Visitor submits the signup form. A Resend contact is created in
#      RELEASES with unsubscribed=true (pending). A signed confirm link
#      is emailed.
#   2. Click → confirm endpoint flips RELEASES to subscribed, adds the
#      contact to LAUNCHES (if configured), and sends the welcome mail
#      with the download link.
#   3. Every email carries RFC 8058 List-Unsubscribe headers pointing
#      at the unsubscribe endpoint, which walks every configured
#      audience and sets unsubscribed=true.
#
# Templates are server-rendered with React (renderToStaticMarkup). No
# user input is embedded in the HTML — only the HMAC-signed token URL
# and the allowlisted locale. Every signup body is strict-parsed with
# zod (unknown keys rejected, source restricted to [A-Za-z0-9_-]).

# Verified sender used for newsletter emails. Format: "Name <addr>".
# Falls back to RESEND_FROM, then a hardcoded default if unset.
NEWSLETTER_FROM=Battery Sensei <hello@your-domain.example>

# Optional. Where replies route. If unset, replies go to NEWSLETTER_FROM.
NEWSLETTER_REPLY_TO=

# HMAC key signing the confirm + unsubscribe tokens. MUST be >= 32 chars
# and kept secret. Rotating it invalidates all outstanding links.
# Generate with: openssl rand -hex 32
NEWSLETTER_TOKEN_SECRET=

# Public origin used to build absolute URLs in the email body (logo,
# confirm link, unsubscribe link). No trailing slash. Defaults to
# https://battery-sensei.app if unset.
PUBLIC_SITE_URL=https://battery-sensei.app
